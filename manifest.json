{
  "schemaVersion": 1,
  "id": "popkenr.omacommander",
  "name": "OmaCommander",
  "version": "2.0.0",
  "author": "popkenr",
  "license": "MIT",
  "description": "OmaCommander: a Nautilus-style file manager for the Omarchy shell, with two panes, Places, search, trash, lister and Total Commander function keys.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "qml/Files.qml",
    "barWidget": "qml/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaCommander",
    "description": "Opens OmaCommander",
    "category": "Tools",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
