#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -W error::SyntaxWarning -m py_compile backend/filesd.py
python3 -m unittest discover -s tests

python3 - <<'PY'
import json
import os

manifest = json.load(open("manifest.json"))
assert manifest["schemaVersion"] == 1
assert manifest["id"] and not manifest["id"].startswith("omarchy.")
for path in manifest["entryPoints"].values():
    assert os.path.isfile(path), path
for root, dirs, files in os.walk("."):
    if ".git" in root.split(os.sep):
        continue
    for name in dirs + files:
        assert not os.path.islink(os.path.join(root, name)), name
print("manifest and layout ok")
PY

if [ -n "${OMARCHY_PATH:-}" ] && command -v qmllint >/dev/null 2>&1; then
  qmllint -I "$OMARCHY_PATH/shell" qml/*.qml
  qmltestrunner -input tests/ui -import "$OMARCHY_PATH/shell"
elif [ -n "${QML_STUB_PATH:-}" ] && command -v qmllint >/dev/null 2>&1; then
  qmllint -I "$QML_STUB_PATH" qml/*.qml
  if command -v qmltestrunner >/dev/null 2>&1; then
    # The stubs have no layer-shell attached properties, so drop those lines
    # in a throwaway copy. A real Omarchy host checks them via OMARCHY_PATH.
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    cp -r qml "$work/qml"
    mkdir -p "$work/tests"
    cp -r tests/ui "$work/tests/ui"
    sed -E -i -e '/WlrLayershell\./d' -e '/^    anchors\.(top|bottom|left|right): true$/d' "$work/qml/Files.qml"
    qmltestrunner -input "$work/tests/ui" -import "$QML_STUB_PATH"
  fi
else
  echo "QML checks skipped: run on Omarchy or set QML_STUB_PATH to a Qt import path"
fi
